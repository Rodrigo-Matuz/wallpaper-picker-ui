{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "wallpaper-picker-ui",
	"version": "3.4.0",
	"identifier": "dev.matuz.wallpaper-picker-ui",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "wallpaper-picker-ui",
				"width": 950,
				"height": 600,
				"fullscreen": false,
				"decorations": false
			}
		],
		"security": {
			"capabilities": ["main-capabilities"]
		}
	},
	"bundle": {
		"active": true,
		"icon": ["icons/icon.ico", "../static/icon-256.png"],
		"createUpdaterArtifacts": true,
		"linux": {
			"deb": {
				"depends": []
			},
			"rpm": {
				"epoch": 0,
				"release": "1",
				"depends": []
			},
			"appimage": {
				"bundleMediaFramework": false
			}
		},
		"windows": {
			"nsis": {
				"installMode": "currentUser"
			}
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCNjlEM0I3QzhBMzdFMTAKUldRUWZxUEl0OU5wUzhuVHdRL2dSRXdFQkRycWZkN2YxMUI4NEZFUnJTdE5QUVQ4dW9Sa2FDNjQK",
			"endpoints": [
				"https://github.com/Rodrigo-Matuz/wallpaper-picker-ui/releases/latest/download/latest.json"
			]
		}
	}
}
