{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "main-capabilities",
	"description": "Capability for the main window",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:window:allow-minimize",
		"core:window:allow-toggle-maximize",
		"core:window:allow-close",
		"core:window:allow-is-maximized",
		"core:window:allow-start-dragging",
		"updater:allow-check",
		"updater:allow-download",
		"updater:allow-install",
		"dialog:allow-open",
		"process:allow-restart",
		{
			"identifier": "fs:allow-config-write",
			"allow": [
				{
					"path": "$CONFIG/WallpaperPickerUI/config.json"
				}
			]
		},
		{
			"identifier": "fs:allow-config-read",
			"allow": [
				{
					"path": "$CONFIG/WallpaperPickerUI/config.json"
				}
			]
		},
		{
			"identifier": "fs:allow-mkdir",
			"allow": [
				{
					"path": "$CONFIG/WallpaperPickerUI"
				},
				{
					"path": "$APPDATA/thumbnails"
				}
			]
		},
		{
			"identifier": "fs:allow-exists",
			"allow": [
				{
					"path": "$CONFIG/WallpaperPickerUI"
				},
				{
					"path": "$CONFIG/WallpaperPickerUI/config.json"
				},
				{
					"path": "$APPDATA/thumbnails"
				},
				{
					"path": "$APPDATA/thumbnails/map.json"
				}
			]
		},
		{
			"identifier": "fs:allow-read-text-file",
			"allow": [
				{
					"path": "$APPDATA/thumbnails/map.json"
				}
			]
		},
		{
			"identifier": "fs:allow-read-file",
			"allow": [
				{
					"path": "$APPDATA/thumbnails/map.json"
				},
				{
					"path": "$APPDATA/thumbnails/*"
				}
			]
		},
		{
			"identifier": "fs:allow-write-file",
			"allow": [
				{
					"path": "$APPDATA/thumbnails/map.json"
				},
				{
					"path": "$APPDATA/thumbnails/map.json.tmp"
				}
			]
		},
		{
			"identifier": "fs:allow-rename",
			"allow": [
				{
					"path": "$APPDATA/thumbnails/map.json"
				},
				{
					"path": "$APPDATA/thumbnails/map.json.tmp"
				}
			]
		},
		{
			"identifier": "fs:allow-remove",
			"allow": [
				{
					"path": "$APPDATA/thumbnails"
				}
			]
		}
	]
}
