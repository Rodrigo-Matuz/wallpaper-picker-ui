{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "main-capabilities",
	"description": "Capability for the main window",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"opener:default",
		"updater:default",
		"dialog:default",
		"process:allow-restart",
		"fs:allow-exists",
		"fs:allow-mkdir",
		{
			"identifier": "fs:allow-config-write",
			"allow": [
				{
					"path": "$CONFIG/WallpaperPickerUI/config.json"
				}
			]
		},
		{
			"identifier": "fs:allow-config-read",
			"allow": [
				{
					"path": "$CONFIG/WallpaperPickerUI/config.json"
				}
			]
		},
		{
			"identifier": "fs:allow-mkdir",
			"allow": [
				{
					"path": "$APPDATA/thumbnails"
				}
			]
		},
		{
			"identifier": "fs:allow-exists",
			"allow": [
				{
					"path": "$APPDATA/thumbnails"
				},
				{
					"path": "$APPDATA/thumbnails/map.json"
				}
			]
		},
		{
			"identifier": "fs:allow-read-file",
			"allow": [
				{
					"path": "$APPDATA/thumbnails/map.json"
				},
				{
					"path": "$APPDATA/thumbnails/*"
				}
			]
		},
		{
			"identifier": "fs:allow-write-file",
			"allow": [
				{
					"path": "$APPDATA/thumbnails/map.json"
				}
			]
		},
		"process:default"
	]
}
